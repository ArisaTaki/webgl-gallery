{
  "name": "webgl-gallery",
  "version": "0.1.17",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "start": "tsx server/index.ts",
    "setup": "tsx scripts/setup-gallery.ts",
    "bootstrap": "node scripts/bootstrap.mjs",
    "doctor": "tsx scripts/gallery-doctor.ts",
    "docker:test": "node scripts/qa-docker-v1.mjs && node scripts/qa-docker-install-v1.mjs && node scripts/qa-docker-image-install-v1.mjs",
    "package:release": "node scripts/package-release.mjs",
    "release:test": "npm run typecheck && npm test && npm run package:release && node scripts/qa-release-package-v1.mjs && npm run docker:test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "build": "tsc --noEmit && vite build",
    "migrate:manifest": "tsx scripts/migrate-manifest-to-db.ts",
    "preview": "NODE_ENV=production tsx server/index.ts",
    "sync:photos": "tsx scripts/sync-photos.ts",
    "test": "tsx scripts/qa-gallery-core.ts && node scripts/qa-admin-api-v112.mjs && node scripts/qa-setup-wizard-v1.mjs && node scripts/qa-setup-no-sqlite-v1.mjs && node scripts/qa-setup-env-first-run-v1.mjs && node scripts/qa-installer-v1.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "cookie": "^2.0.0",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "pg": "^8.22.0",
    "sharp": "^0.34.3",
    "three": "^0.179.1",
    "vite": "^7.1.5"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "@types/cookie": "^0.6.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}

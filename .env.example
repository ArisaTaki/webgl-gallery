# Local host port for Docker. Open http://localhost:5280 after start.
WEBGL_GALLERY_PORT=5280
WEBGL_GALLERY_COMPOSE_PROJECT=webgl-gallery
WEBGL_GALLERY_IMAGE_MODE=prebuilt
WEBGL_GALLERY_IMAGE=ghcr.io/arisataki/webgl-gallery:latest
WEBGL_GALLERY_STORAGE_MODE=local

# Optional: set WEBGL_GALLERY_IMAGE_MODE=build to build locally instead.

# Optional public hostname used only for installer output when you enable Tunnel.
WEBGL_GALLERY_HOSTNAME=

# Optional: set this after creating a Cloudflare Tunnel token.
# Start with: docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=

# Optional: set WEBGL_GALLERY_STORAGE_MODE=r2 and preseed R2 here.
# If these stay empty, the app uses local storage and /setup can still change it later.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
R2_PRIVATE_BUCKET=
R2_PUBLIC_BASE_URL=

# Optional: use Postgres instead of the default local SQLite.
DATABASE_URL=

# Local host port for Docker. Open http://localhost:5279 after start.
WEBGL_GALLERY_PORT=5279
WEBGL_GALLERY_COMPOSE_PROJECT=webgl-gallery
WEBGL_GALLERY_IMAGE_MODE=build

# Optional: after GitHub Release publishes a GHCR image, set mode to prebuilt.
# WEBGL_GALLERY_IMAGE_MODE=prebuilt
# WEBGL_GALLERY_IMAGE=ghcr.io/arisataki/webgl-gallery:latest

# Public hostname used when you enable the Cloudflare Tunnel profile.
WEBGL_GALLERY_HOSTNAME=gallery.irop.one

# Optional: set this after creating a Cloudflare Tunnel token.
# Start with: docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=

# Optional: preseed R2 with environment variables instead of filling /setup.
# Most users should use /setup because it stores secrets in .gallery/config.json.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
R2_PRIVATE_BUCKET=
R2_PUBLIC_BASE_URL=

# Optional: use Postgres instead of the default local SQLite.
DATABASE_URL=
